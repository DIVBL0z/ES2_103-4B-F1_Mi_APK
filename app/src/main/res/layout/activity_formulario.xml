<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText android:id="@+id/edtUbicacion"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Sala o ubicación (ej. Sala servidores 1)"
        android:inputType="textCapSentences" />

    <EditText android:id="@+id/edtTemperatura"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Temperatura en °C"
        android:inputType="numberDecimal|numberSigned" />

    <EditText android:id="@+id/edtHora"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Hora del registro (HH:mm)"
        android:inputType="text" />

    <Button android:id="@+id/btnGuardar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Guardar" />
</LinearLayout>